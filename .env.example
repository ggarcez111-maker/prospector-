# ==========================================================
# Prospector - variaveis de ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# ==========================================================

# --- Modulo 2: Groq (API gratuita compativel com OpenAI) ---
# Crie sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# --- Modulo 1: Descoberta de leads (Google Maps / Playwright) ---
GMAPS_LANGUAGE=pt-BR
MAX_LEADS=30
HEADLESS=true

# --- Modulo 3: WhatsApp (pywhatkit) ---
# Codigo do pais sem o "+" (Brasil = 55)
WHATSAPP_COUNTRY_CODE=55
# Limite de mensagens enviadas por execucao/dia
DAILY_MESSAGE_LIMIT=15
# Intervalo aleatorio entre envios (segundos) - "drip mode"
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=40
# Tempo de espera para o WhatsApp Web carregar antes de enviar (segundos)
WHATSAPP_WAIT_TIME=25

# --- Score / qualificacao ---
MIN_LEAD_SCORE=40

# --- Demo (landing page por lead) ---
DEMO_OUTPUT_DIR=demos
# Envia um print da demo como imagem, em vez de mensagem so em texto (true/false)
SEND_SCREENSHOT=false

# --- Hospedagem automatica da demo (GitHub Pages, opcional mas recomendado) ---
# Sem isso, a demo fica so em disco local (sem link publico para enviar).
# 1. Crie um repositorio no GitHub (pode ser so para isso) e habilite o
#    GitHub Pages apontando para a branch definida em GITHUB_BRANCH.
# 2. Gere um token em https://github.com/settings/tokens (escopo "repo").
GITHUB_TOKEN=
GITHUB_REPO=usuario/repositorio
GITHUB_BRANCH=gh-pages
# Opcional: sobrescreve a URL publica calculada (ex: dominio customizado)
GITHUB_PAGES_BASE_URL=

# --- Warm-up (rampa de aquecimento do numero, recomendado para numeros novos) ---
WARMUP_ENABLED=false

# --- CRM ---
CRM_DB=prospector.db

# --- Logging ---
LOG_FILE=envios.log
LOG_LEVEL=INFO
